#!/usr/bin/env bash
#
# SquirrelOps Home — .pkg Postinstall Script
#
# Runs after payload extraction. Sets up data directories, config,
# launchd plist, and starts the sensor service.
#
# This script runs as root during .pkg installation.
#
set -euo pipefail

INSTALL_DIR="/Library/SquirrelOps/sensor"
DATA_DIR="$INSTALL_DIR/data"
LOG_DIR="$INSTALL_DIR/logs"
CONFIG_FILE="$INSTALL_DIR/config.yaml"
CONFIG_BACKUP="${CONFIG_FILE}.bak"

# Detect Python environment mode (standalone or venv).
# The build writes a .python-mode marker file to indicate which was used.
PYTHON_MODE_FILE="$INSTALL_DIR/.python-mode"
if [ -f "$PYTHON_MODE_FILE" ] && [ "$(cat "$PYTHON_MODE_FILE")" = "standalone" ]; then
    PYTHON_PATH="$INSTALL_DIR/python/bin/python3"
else
    PYTHON_PATH="$INSTALL_DIR/venv/bin/python"
fi

PLIST_NAME="com.squirrelops.sensor"
PLIST_TEMPLATE="$INSTALL_DIR/com.squirrelops.sensor.plist"
PLIST_DEST="/Library/LaunchDaemons/${PLIST_NAME}.plist"

# Dedicated non-root service account the sensor daemon runs as, so an RCE in the
# network-facing sensor is not root. The privileged helper authorizes this
# account (see SquirrelOpsHelper/main.swift serviceAccountUID()).
SENSOR_USER="_squirrelops"
SENSOR_GROUP="_squirrelops"

# ---------------------------------------------------------------------------
# Step 0: Create the dedicated service account (idempotent)
# ---------------------------------------------------------------------------
create_service_account() {
    if dscl . -read "/Users/${SENSOR_USER}" >/dev/null 2>&1; then
        local existing_gid
        existing_gid=$(dscl . -read "/Users/${SENSOR_USER}" PrimaryGroupID 2>/dev/null \
            | awk '{print $2}')
        if [ -z "$existing_gid" ]; then
            echo "[postinstall] WARNING: existing ${SENSOR_USER} has no primary group ID."
            return 1
        fi
        # Repair upgrades from installations that created the user without a
        # resolvable matching group; the helper fails closed without this.
        dscl . -create "/Groups/${SENSOR_GROUP}" 2>/dev/null || true
        dscl . -create "/Groups/${SENSOR_GROUP}" PrimaryGroupID "$existing_gid"
        echo "[postinstall] Service account ${SENSOR_USER} already exists (gid ${existing_gid})."
        return 0
    fi
    echo "[postinstall] Creating service account ${SENSOR_USER}..."
    # Pick a free UID/GID in the hidden system-service range (300-499).
    local new_id=""
    for candidate in $(seq 300 499); do
        if ! dscl . -list /Users UniqueID | awk '{print $2}' | grep -qx "$candidate"; then
            new_id="$candidate"
            break
        fi
    done
    if [ -z "$new_id" ]; then
        echo "[postinstall] WARNING: no free service UID found; sensor will run as root."
        return 1
    fi
    dscl . -create "/Groups/${SENSOR_GROUP}" 2>/dev/null || true
    dscl . -create "/Groups/${SENSOR_GROUP}" PrimaryGroupID "$new_id"
    dscl . -create "/Users/${SENSOR_USER}"
    dscl . -create "/Users/${SENSOR_USER}" RealName "SquirrelOps Sensor"
    dscl . -create "/Users/${SENSOR_USER}" UserShell /usr/bin/false
    dscl . -create "/Users/${SENSOR_USER}" UniqueID "$new_id"
    dscl . -create "/Users/${SENSOR_USER}" PrimaryGroupID "$new_id"
    dscl . -create "/Users/${SENSOR_USER}" NFSHomeDirectory /var/empty
    dscl . -create "/Users/${SENSOR_USER}" IsHidden 1
    echo "[postinstall] Created ${SENSOR_USER} (uid/gid ${new_id})."
}

RUN_AS_SERVICE_ACCOUNT=1
create_service_account || RUN_AS_SERVICE_ACCOUNT=0

# ---------------------------------------------------------------------------
# Step 1: Create data directories
# ---------------------------------------------------------------------------
echo "[postinstall] Creating data directories..."
mkdir -p "$DATA_DIR"
mkdir -p "$LOG_DIR"
mkdir -p "$INSTALL_DIR/run"

# ---------------------------------------------------------------------------
# Step 1b: Repair venv Python symlinks
# ---------------------------------------------------------------------------
# The venv's python symlink may point to the build machine's Python, which
# might not exist on the target system (e.g., built with 3.13 but target has
# 3.14). Re-link to whatever python3 is available on this system.
if [ "$PYTHON_PATH" = "$INSTALL_DIR/venv/bin/python" ]; then
    VENV_BIN="$INSTALL_DIR/venv/bin"
    # Find the system Python 3
    SYSTEM_PYTHON=""
    for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
        if [ -x "$candidate" ]; then
            SYSTEM_PYTHON="$candidate"
            break
        fi
    done

    if [ -n "$SYSTEM_PYTHON" ]; then
        SYSTEM_PY_VERSION=$("$SYSTEM_PYTHON" -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')" 2>/dev/null || true)
        SYSTEM_PY_REAL=$(readlink -f "$SYSTEM_PYTHON" 2>/dev/null || "$SYSTEM_PYTHON" -c "import os,sys; print(os.path.realpath(sys.executable))" 2>/dev/null || true)

        if [ -n "$SYSTEM_PY_VERSION" ] && [ -n "$SYSTEM_PY_REAL" ]; then
            echo "[postinstall] System Python: $SYSTEM_PY_REAL (${SYSTEM_PY_VERSION})"

            # Check if the venv's python actually works
            if ! "$VENV_BIN/python" --version >/dev/null 2>&1; then
                echo "[postinstall] Venv Python is broken — repairing symlinks..."

                # Remove stale symlinks
                rm -f "$VENV_BIN/python" "$VENV_BIN/python3"
                # Remove old versioned symlink (e.g. python3.13)
                find "$VENV_BIN" -maxdepth 1 -name "python3.*" -type l -delete 2>/dev/null || true

                # Create fresh symlinks pointing to system Python
                ln -s "$SYSTEM_PY_REAL" "$VENV_BIN/python3.${SYSTEM_PY_VERSION#*.}"
                ln -s "python3.${SYSTEM_PY_VERSION#*.}" "$VENV_BIN/python3"
                ln -s "python3" "$VENV_BIN/python"

                # Verify the repair worked
                if "$VENV_BIN/python" --version >/dev/null 2>&1; then
                    echo "[postinstall] Venv Python repaired successfully."
                else
                    echo "[postinstall] WARNING: Venv Python repair failed."
                fi
            else
                echo "[postinstall] Venv Python is working."
            fi
        fi
    else
        echo "[postinstall] WARNING: No system Python 3 found."
    fi
fi

# ---------------------------------------------------------------------------
# Step 2: Handle config file
# ---------------------------------------------------------------------------
if [ -f "$CONFIG_BACKUP" ]; then
    # Upgrade path: restore backed-up config
    echo "[postinstall] Restoring config from backup..."
    mv "$CONFIG_BACKUP" "$CONFIG_FILE"
elif [ ! -f "$CONFIG_FILE" ]; then
    # Fresh install: generate default config
    echo "[postinstall] Generating default config.yaml..."
    cat > "$CONFIG_FILE" << YAML
# SquirrelOps Home Sensor — Configuration
# See documentation for all available options.

profile: standard

sensor:
  name: SquirrelOps Home Sensor
  data_dir: "$DATA_DIR"
  port: 8443

network:
  interface: auto
  scan_interval: 300

alerts:
  retention_days: 90

pairing:
  socket_path: "$INSTALL_DIR/run/pairing.sock"
YAML
fi

# ---------------------------------------------------------------------------
# Step 3: Install launchd plist from template
# ---------------------------------------------------------------------------
echo "[postinstall] Installing launchd plist..."

if [ -f "$PLIST_TEMPLATE" ]; then
    sed \
        -e "s|__PYTHON_PATH__|${PYTHON_PATH}|g" \
        -e "s|__CONFIG_PATH__|${CONFIG_FILE}|g" \
        -e "s|__INSTALL_DIR__|${INSTALL_DIR}|g" \
        -e "s|__DATA_DIR__|${DATA_DIR}|g" \
        -e "s|__LOG_DIR__|${LOG_DIR}|g" \
        "$PLIST_TEMPLATE" > "$PLIST_DEST"
else
    echo "[postinstall] WARNING: Plist template not found at $PLIST_TEMPLATE"
    echo "[postinstall] Sensor service will not be started automatically."
    exit 0
fi

# ---------------------------------------------------------------------------
# Step 3b: Run the daemon as the non-root service account
# ---------------------------------------------------------------------------
# The plist template carries no UserName (it is shared with the per-user
# LaunchAgent install). For the root .pkg deployment we inject it here and give
# the account ownership of the directories it must read/write.
if [ "$RUN_AS_SERVICE_ACCOUNT" = "1" ]; then
    echo "[postinstall] Configuring daemon to run as ${SENSOR_USER}..."
    /usr/libexec/PlistBuddy -c "Add :UserName string ${SENSOR_USER}" "$PLIST_DEST" 2>/dev/null \
        || /usr/libexec/PlistBuddy -c "Set :UserName ${SENSOR_USER}" "$PLIST_DEST" 2>/dev/null || true
    /usr/libexec/PlistBuddy -c "Add :GroupName string ${SENSOR_GROUP}" "$PLIST_DEST" 2>/dev/null \
        || /usr/libexec/PlistBuddy -c "Set :GroupName ${SENSOR_GROUP}" "$PLIST_DEST" 2>/dev/null || true
    # The sensor writes the DB, certs, secret store, and logs; the venv/python
    # stays root-owned (read+execute only).
    chown -R "${SENSOR_USER}:${SENSOR_GROUP}" "$DATA_DIR" "$LOG_DIR" 2>/dev/null || true
    chown "${SENSOR_USER}:${SENSOR_GROUP}" "$INSTALL_DIR/run" 2>/dev/null || true
    chown "${SENSOR_USER}:${SENSOR_GROUP}" "$CONFIG_FILE" 2>/dev/null || true
    chmod 700 "$DATA_DIR" 2>/dev/null || true
    chmod 755 "$INSTALL_DIR/run" 2>/dev/null || true
    chmod 600 "$CONFIG_FILE" 2>/dev/null || true
fi
chmod 600 "$CONFIG_FILE" 2>/dev/null || true
chmod 700 "$DATA_DIR" 2>/dev/null || true

# The app package may have started the helper before the service account was
# created. Restart it so the socket is recreated as root:_squirrelops 0660.
if [ -f /Library/LaunchDaemons/com.squirrelops.helper.plist ]; then
    launchctl kickstart -k system/com.squirrelops.helper 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# Step 4: Set permissions on plist
# ---------------------------------------------------------------------------
chown root:wheel "$PLIST_DEST"
chmod 644 "$PLIST_DEST"

# ---------------------------------------------------------------------------
# Step 5: Load the sensor service
# ---------------------------------------------------------------------------
echo "[postinstall] Loading sensor service..."
launchctl bootstrap system "$PLIST_DEST" 2>/dev/null || {
    echo "[postinstall] WARNING: Failed to bootstrap sensor service."
    echo "[postinstall] You may need to load it manually:"
    echo "[postinstall]   sudo launchctl bootstrap system $PLIST_DEST"
}

# ---------------------------------------------------------------------------
# Step 6: Health check (best effort — don't block installer)
# ---------------------------------------------------------------------------
echo "[postinstall] Waiting for sensor to start..."

HEALTH_URL="https://localhost:8443/system/health"
TIMEOUT=30
INTERVAL=2
ELAPSED=0

while [ "$ELAPSED" -lt "$TIMEOUT" ]; do
    # Use curl with --insecure since the sensor uses a self-signed cert
    if curl -sf --insecure --max-time 3 "$HEALTH_URL" >/dev/null 2>&1; then
        echo "[postinstall] Sensor is healthy."
        break
    fi
    sleep "$INTERVAL"
    ELAPSED=$((ELAPSED + INTERVAL))
done

if [ "$ELAPSED" -ge "$TIMEOUT" ]; then
    echo "[postinstall] WARNING: Sensor did not respond within ${TIMEOUT}s."
    echo "[postinstall] Check logs at: $LOG_DIR/squirrelops-sensor.log"
fi

echo "[postinstall] Done."
exit 0
