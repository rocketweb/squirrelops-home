#!/usr/bin/env bash
#
# SquirrelOps Home — .pkg Postinstall Script
#
# Runs after payload extraction. Sets up data directories, config,
# launchd plist, and starts the sensor service.
#
# This script runs as root during .pkg installation.
#
set -euo pipefail

INSTALL_DIR="/Library/SquirrelOps/sensor"
DATA_DIR="$INSTALL_DIR/data"
LOG_DIR="$INSTALL_DIR/logs"
CONFIG_FILE="$INSTALL_DIR/config.yaml"
CONFIG_BACKUP="${CONFIG_FILE}.bak"

# Release packages carry a pinned standalone Python runtime. Refuse an
# incomplete or legacy host-bound venv payload instead of reporting success
# and hoping a compatible target interpreter happens to exist.
PYTHON_MODE_FILE="$INSTALL_DIR/.python-mode"
EXPECTED_VERSION_FILE="$INSTALL_DIR/VERSION"
if [ ! -f "$PYTHON_MODE_FILE" ] \
    || [ "$(cat "$PYTHON_MODE_FILE")" != "standalone" ]; then
    echo "[postinstall] Package does not contain the required standalone Python runtime." >&2
    exit 1
fi
PYTHON_RUNTIME="$INSTALL_DIR/python"
PYTHON_PATH="$PYTHON_RUNTIME/bin/python3"

runtime_entry_is_safe() {
    local runtime_root="$1"
    local entry="$2"
    local metadata
    local owner
    local group
    local kind
    local mode
    local mode_decimal
    local resolved

    metadata=$(
        /usr/bin/stat -f '%Su|%Sg|%HT|%Lp' "$entry" 2>/dev/null
    ) || return 1
    IFS='|' read -r owner group kind mode <<< "$metadata"
    [ "$owner" = "root" ] && [ "$group" = "wheel" ] \
        && [[ "$mode" =~ ^[0-7]{3,4}$ ]] \
        || return 1
    mode_decimal=$((8#$mode))
    [ "$((mode_decimal & 8#022))" -eq 0 ] || return 1

    case "$kind" in
        Directory|"Regular File") ;;
        "Symbolic Link")
            resolved=$(/bin/realpath "$entry" 2>/dev/null) || return 1
            case "$resolved" in
                "$runtime_root"|"$runtime_root"/*) ;;
                *) return 1 ;;
            esac
            ;;
        *) return 1 ;;
    esac
}

validate_root_owned_python_runtime() {
    local runtime_root="$1"
    local acl_entry
    [ -d "$runtime_root" ] && [ ! -L "$runtime_root" ] || return 1
    runtime_root=$(/bin/realpath "$runtime_root" 2>/dev/null) || return 1
    acl_entry=$(
        /usr/bin/find "$runtime_root" -xdev -acl -print -quit
    ) || return 1
    [ -z "$acl_entry" ] || return 1
    runtime_entry_is_safe "$runtime_root" "$runtime_root" || return 1
    /usr/bin/find "$runtime_root" -xdev -mindepth 1 -print0 \
        | while IFS= read -r -d '' entry; do
            runtime_entry_is_safe "$runtime_root" "$entry" || return 1
        done
}

isolated_python() {
    /usr/bin/env -i \
        PATH=/usr/bin:/bin:/usr/sbin:/sbin \
        LC_ALL=C \
        "$PYTHON_PATH" -I "$@"
}

if [ ! -x "$PYTHON_PATH" ]; then
    echo "[postinstall] Standalone Python is missing or not executable." >&2
    exit 1
fi
if ! validate_root_owned_python_runtime "$PYTHON_RUNTIME"; then
    echo "[postinstall] Standalone Python runtime ownership or permissions are unsafe." >&2
    exit 1
fi
if [ ! -f "$EXPECTED_VERSION_FILE" ]; then
    echo "[postinstall] Package VERSION marker is missing." >&2
    exit 1
fi
EXPECTED_SENSOR_VERSION="$(tr -d '[:space:]' < "$EXPECTED_VERSION_FILE")"
if ! INSTALLED_SENSOR_VERSION=$(isolated_python -c \
    'from importlib.metadata import version; print(version("squirrelops-home-sensor"))' \
    2>/dev/null)
then
    echo "[postinstall] Cannot read the embedded sensor package version." >&2
    exit 1
fi
if [ "$INSTALLED_SENSOR_VERSION" != "$EXPECTED_SENSOR_VERSION" ]; then
    echo "[postinstall] Embedded sensor version $INSTALLED_SENSOR_VERSION does not match package version $EXPECTED_SENSOR_VERSION." >&2
    exit 1
fi

PLIST_NAME="com.squirrelops.sensor"
PLIST_TEMPLATE="$INSTALL_DIR/com.squirrelops.sensor.plist"
PLIST_DEST="/Library/LaunchDaemons/${PLIST_NAME}.plist"
HELPER_LABEL="com.squirrelops.helper"
HELPER_BINARY="/Library/PrivilegedHelperTools/com.squirrelops.helper"
HELPER_PLIST="/Library/LaunchDaemons/com.squirrelops.helper.plist"
HELPER_SOCKET="/var/run/squirrelops-helper.sock"
PLIST_TEMP=""
ACCOUNT_MARKER_TEMP=""
CONFIG_MIGRATION_TEMP=""

cleanup_staged_plist() {
    if [ -n "$PLIST_TEMP" ]; then
        rm -f -- "$PLIST_TEMP"
    fi
    if [ -n "$ACCOUNT_MARKER_TEMP" ]; then
        rm -f -- "$ACCOUNT_MARKER_TEMP"
    fi
    if [ -n "$CONFIG_MIGRATION_TEMP" ]; then
        rm -f -- "$CONFIG_MIGRATION_TEMP"
    fi
}
trap cleanup_staged_plist EXIT

# Dedicated non-root service account the sensor daemon runs as, so an RCE in the
# network-facing sensor is not root. The privileged helper authorizes this
# account (see SquirrelOpsHelper/main.swift serviceAccountUID()).
SENSOR_USER="_squirrelops"
SENSOR_GROUP="_squirrelops"
SENSOR_UID=""
SENSOR_GID=""
STAGED_SENSOR_USER="_squirrelops_installing"
STAGED_SENSOR_GROUP="_squirrelops_installing"
ACCOUNT_PROVISIONING_DIR="/var/db/com.squirrelops.sensor"
ACCOUNT_PROVISIONING_MARKER="$ACCOUNT_PROVISIONING_DIR/account-provisioning"
ACCOUNT_DEPROVISIONING_MARKER="$ACCOUNT_PROVISIONING_DIR/account-deprovisioning"

# ---------------------------------------------------------------------------
# Step 0: Create the dedicated service account (idempotent)
# ---------------------------------------------------------------------------
directory_service_value() {
    local record="$1"
    local key="$2"
    local value
    if ! value=$(
        /usr/bin/dscl . -read "$record" "$key" 2>/dev/null \
            | /usr/bin/awk \
                -v expected="${key}:" \
                -v native_hidden="dsAttrTypeNative:IsHidden:" '
                ($1 == expected \
                    || (expected == "IsHidden:" && $1 == native_hidden)) \
                    && NF == 2 {
                    value = $2
                    count++
                }
                END {
                    if (count != 1) {
                        exit 1
                    }
                    print value
                }
            '
    ); then
        return 1
    fi
    printf '%s\n' "$value"
}

validate_service_identity() {
    local unique_uid_owner
    local unique_gid_owner
    local shell
    local home
    local hidden

    SENSOR_UID=$(directory_service_value \
        "/Users/${SENSOR_USER}" "UniqueID") || return 1
    SENSOR_GID=$(directory_service_value \
        "/Users/${SENSOR_USER}" "PrimaryGroupID") || return 1
    shell=$(directory_service_value \
        "/Users/${SENSOR_USER}" "UserShell") || return 1
    home=$(directory_service_value \
        "/Users/${SENSOR_USER}" "NFSHomeDirectory") || return 1
    hidden=$(directory_service_value \
        "/Users/${SENSOR_USER}" "IsHidden") || return 1

    [[ "$SENSOR_UID" =~ ^[0-9]+$ ]] \
        && [[ "$SENSOR_GID" =~ ^[0-9]+$ ]] \
        && [ "$SENSOR_UID" -ge 300 ] && [ "$SENSOR_UID" -le 499 ] \
        && [ "$SENSOR_GID" = "$SENSOR_UID" ] \
        && [ "$shell" = "/usr/bin/false" ] \
        && [ "$home" = "/var/empty" ] \
        && [ "$hidden" = "1" ] \
        || return 1
    [ "$(directory_service_value \
        "/Groups/${SENSOR_GROUP}" "PrimaryGroupID")" = "$SENSOR_GID" ] \
        || return 1

    unique_uid_owner=$(
        /usr/bin/dscl . -list /Users UniqueID 2>/dev/null \
            | /usr/bin/awk -v expected_uid="$SENSOR_UID" '
                $2 == expected_uid { owner = $1; count++ }
                END {
                    if (count == 1) {
                        print owner
                    }
                }
            '
    ) || return 1
    unique_gid_owner=$(
        /usr/bin/dscl . -list /Groups PrimaryGroupID 2>/dev/null \
            | /usr/bin/awk -v expected_gid="$SENSOR_GID" '
                $2 == expected_gid { owner = $1; count++ }
                END {
                    if (count == 1) {
                        print owner
                    }
                }
            '
    ) || return 1
    [ "$unique_uid_owner" = "$SENSOR_USER" ] \
        && [ "$unique_gid_owner" = "$SENSOR_GROUP" ]
}

read_account_provisioning_id() {
    local provisioned_id
    if [ -L "$ACCOUNT_PROVISIONING_DIR" ] \
        || [ ! -d "$ACCOUNT_PROVISIONING_DIR" ] \
        || [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp' \
            "$ACCOUNT_PROVISIONING_DIR")" != "root:wheel:700" ] \
        || [ -L "$ACCOUNT_PROVISIONING_MARKER" ] \
        || [ ! -f "$ACCOUNT_PROVISIONING_MARKER" ] \
        || [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp:%l:%z' \
            "$ACCOUNT_PROVISIONING_MARKER")" != "root:wheel:600:1:4" ]
    then
        return 1
    fi
    provisioned_id=$(/bin/cat "$ACCOUNT_PROVISIONING_MARKER") \
        || return 1
    [[ "$provisioned_id" =~ ^[0-9]{3}$ ]] \
        && [ "$provisioned_id" -ge 300 ] \
        && [ "$provisioned_id" -le 499 ] \
        || return 1
    printf '%s\n' "$provisioned_id"
}

write_account_provisioning_id() {
    local provisioned_id="$1"
    if [ -L "$ACCOUNT_PROVISIONING_DIR" ] \
        || { [ -e "$ACCOUNT_PROVISIONING_DIR" ] \
            && [ ! -d "$ACCOUNT_PROVISIONING_DIR" ]; }
    then
        return 1
    fi
    if ! /usr/bin/install -d -o root -g wheel -m 700 \
        "$ACCOUNT_PROVISIONING_DIR" \
        || [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp' \
            "$ACCOUNT_PROVISIONING_DIR")" != "root:wheel:700" ]
    then
        return 1
    fi
    ACCOUNT_MARKER_TEMP=$(
        /usr/bin/mktemp \
            "$ACCOUNT_PROVISIONING_DIR/.account-provisioning.XXXXXXXX"
    ) || return 1
    if ! printf '%s\n' "$provisioned_id" > "$ACCOUNT_MARKER_TEMP" \
        || ! /usr/sbin/chown root:wheel "$ACCOUNT_MARKER_TEMP" \
        || ! /bin/chmod 600 "$ACCOUNT_MARKER_TEMP" \
        || ! /bin/mv -fh "$ACCOUNT_MARKER_TEMP" \
            "$ACCOUNT_PROVISIONING_MARKER" \
        || ! /bin/sync
    then
        return 1
    fi
    ACCOUNT_MARKER_TEMP=""
    [ "$(read_account_provisioning_id)" = "$provisioned_id" ]
}

directory_service_text_value() {
    local record="$1"
    local key="$2"
    /usr/bin/dscl . -read "$record" "$key" 2>/dev/null \
        | /usr/bin/awk \
            -v expected="${key}:" \
            -v native_hidden="dsAttrTypeNative:IsHidden:" '
            $1 == expected \
                || (expected == "IsHidden:" && $1 == native_hidden) {
                $1 = ""
                sub(/^ /, "")
                value = $0
                count++
            }
            END {
                if (count != 1 || value == "") {
                    exit 1
                }
                print value
            }
        '
}

record_value_matches_or_is_missing() {
    local record="$1"
    local key="$2"
    local expected="$3"
    local actual
    if ! /usr/bin/dscl . -read "$record" "$key" >/dev/null 2>&1; then
        /usr/bin/dscl . -read "$record" >/dev/null 2>&1
        return
    fi
    actual=$(directory_service_text_value "$record" "$key") || return 1
    [ "$actual" = "$expected" ]
}

record_attribute_is_empty_or_missing() {
    local record="$1"
    local key="$2"
    local output
    if ! output=$(
        /usr/bin/dscl . -read "$record" "$key" 2>/dev/null
    ); then
        /usr/bin/dscl . -read "$record" >/dev/null 2>&1
        return
    fi
    printf '%s\n' "$output" \
        | /usr/bin/awk -v expected="${key}:" '
            $1 == expected && NF == 1 { seen++ ; next }
            NF != 0 { bad = 1 }
            END { exit !(seen == 1 && bad == 0) }
        '
}

read_account_deprovisioning_id() {
    local provisioned_id
    if [ -L "$ACCOUNT_PROVISIONING_DIR" ] \
        || [ ! -d "$ACCOUNT_PROVISIONING_DIR" ] \
        || [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp' \
            "$ACCOUNT_PROVISIONING_DIR")" != "root:wheel:700" ] \
        || [ -L "$ACCOUNT_DEPROVISIONING_MARKER" ] \
        || [ ! -f "$ACCOUNT_DEPROVISIONING_MARKER" ] \
        || [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp:%l:%z' \
            "$ACCOUNT_DEPROVISIONING_MARKER")" != "root:wheel:600:1:4" ]
    then
        return 1
    fi
    provisioned_id=$(/bin/cat "$ACCOUNT_DEPROVISIONING_MARKER") \
        || return 1
    [[ "$provisioned_id" =~ ^[0-9]{3}$ ]] \
        && [ "$provisioned_id" -ge 300 ] \
        && [ "$provisioned_id" -le 499 ] \
        || return 1
    printf '%s\n' "$provisioned_id"
}

record_id_matches_or_is_unset() {
    local record="$1"
    local key="$2"
    local expected_id="$3"
    local actual_id
    if ! /usr/bin/dscl . -read "$record" >/dev/null 2>&1; then
        return 0
    fi
    if ! /usr/bin/dscl . -read "$record" "$key" >/dev/null 2>&1; then
        return 0
    fi
    if ! actual_id=$(directory_service_value "$record" "$key"); then
        return 1
    fi
    [ "$actual_id" = "$expected_id" ]
}

deprovisioning_records_match_id() {
    local provisioned_id="$1"
    local conflicting_user
    local conflicting_group
    local user_present=0
    local group_present=0

    if /usr/bin/dscl . -read "/Users/${SENSOR_USER}" >/dev/null 2>&1; then
        user_present=1
    fi
    if /usr/bin/dscl . -read "/Groups/${SENSOR_GROUP}" >/dev/null 2>&1; then
        group_present=1
    fi
    if [ "$user_present" -eq 1 ]; then
        [ "$group_present" -eq 1 ] || return 1
        record_value_matches_or_is_missing \
            "/Users/${SENSOR_USER}" "RealName" "SquirrelOps Sensor" \
            && record_value_matches_or_is_missing \
                "/Users/${SENSOR_USER}" "UserShell" "/usr/bin/false" \
            && record_value_matches_or_is_missing \
                "/Users/${SENSOR_USER}" "UniqueID" "$provisioned_id" \
            && record_value_matches_or_is_missing \
                "/Users/${SENSOR_USER}" "PrimaryGroupID" "$provisioned_id" \
            && record_value_matches_or_is_missing \
                "/Users/${SENSOR_USER}" "NFSHomeDirectory" "/var/empty" \
            && record_value_matches_or_is_missing \
                "/Users/${SENSOR_USER}" "IsHidden" "1" \
            || return 1
    fi
    if [ "$group_present" -eq 1 ]; then
        [ "$(directory_service_value \
            "/Groups/${SENSOR_GROUP}" "PrimaryGroupID")" \
            = "$provisioned_id" ] \
            && record_attribute_is_empty_or_missing \
                "/Groups/${SENSOR_GROUP}" "GroupMembership" \
            && record_attribute_is_empty_or_missing \
                "/Groups/${SENSOR_GROUP}" "GroupMembers" \
            || return 1
    fi

    conflicting_user=$(
        /usr/bin/dscl . -list /Users UniqueID 2>/dev/null \
            | /usr/bin/awk \
                -v id="$provisioned_id" \
                -v final="$SENSOR_USER" \
                '$2 == id && $1 != final { print $1 }'
    ) || return 1
    conflicting_group=$(
        /usr/bin/dscl . -list /Groups PrimaryGroupID 2>/dev/null \
            | /usr/bin/awk \
                -v id="$provisioned_id" \
                -v final="$SENSOR_GROUP" \
                '$2 == id && $1 != final { print $1 }'
    ) || return 1
    [ -z "$conflicting_user" ] && [ -z "$conflicting_group" ]
}

retire_account_provisioning_dir() {
    if [ ! -e "$ACCOUNT_PROVISIONING_DIR" ] \
        && [ ! -L "$ACCOUNT_PROVISIONING_DIR" ]
    then
        return 0
    fi
    if [ -L "$ACCOUNT_PROVISIONING_DIR" ] \
        || [ ! -d "$ACCOUNT_PROVISIONING_DIR" ] \
        || [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp' \
            "$ACCOUNT_PROVISIONING_DIR")" != "root:wheel:700" ]
    then
        return 1
    fi
    /usr/bin/find "$ACCOUNT_PROVISIONING_DIR" \
        -xdev -mindepth 1 -maxdepth 1 -print0 \
        | while IFS= read -r -d '' entry; do
            local name
            name=$(/usr/bin/basename "$entry") || return 1
            case "$name" in
                .account-provisioning.*|.account-deprovisioning.*) ;;
                *) return 1 ;;
            esac
            [ ! -L "$entry" ] \
                && [ "$(/usr/bin/stat -f '%Su:%Sg:%HT:%Lp:%l' "$entry")" \
                    = "root:wheel:Regular File:600:1" ] \
                || return 1
            rm -f -- "$entry" || return 1
        done \
        || return 1
    rmdir "$ACCOUNT_PROVISIONING_DIR" 2>/dev/null
}

retire_account_provisioning_marker() {
    rm -f -- "$ACCOUNT_PROVISIONING_MARKER" || return 1
    retire_account_provisioning_dir || return 1
    /bin/sync
}

cleanup_interrupted_account_deprovisioning() {
    local provisioned_id
    if [ ! -e "$ACCOUNT_DEPROVISIONING_MARKER" ] \
        && [ ! -L "$ACCOUNT_DEPROVISIONING_MARKER" ]
    then
        return 0
    fi
    [ ! -e "$ACCOUNT_PROVISIONING_MARKER" ] \
        && [ ! -L "$ACCOUNT_PROVISIONING_MARKER" ] \
        || return 1
    provisioned_id=$(read_account_deprovisioning_id) || return 1
    if /usr/bin/dscl . -read "/Users/${STAGED_SENSOR_USER}" \
            >/dev/null 2>&1 \
        || /usr/bin/dscl . -read "/Groups/${STAGED_SENSOR_GROUP}" \
            >/dev/null 2>&1 \
        || ! deprovisioning_records_match_id "$provisioned_id"
    then
        return 1
    fi

    SENSOR_UID="$provisioned_id"
    terminate_sensor_processes || return 1
    /usr/bin/crontab -u "$SENSOR_USER" -r >/dev/null 2>&1 || true
    if /usr/bin/dscl . -read "/Users/${SENSOR_USER}" >/dev/null 2>&1; then
        /usr/bin/dscl . -delete "/Users/${SENSOR_USER}" || return 1
    fi
    if /usr/bin/dscl . -read "/Groups/${SENSOR_GROUP}" >/dev/null 2>&1; then
        /usr/bin/dscl . -delete "/Groups/${SENSOR_GROUP}" || return 1
    fi
    ! /usr/bin/dscl . -read "/Users/${SENSOR_USER}" >/dev/null 2>&1 \
        && ! /usr/bin/dscl . -read "/Groups/${SENSOR_GROUP}" \
            >/dev/null 2>&1 \
        || return 1
    rm -f -- "$ACCOUNT_DEPROVISIONING_MARKER" || return 1
    retire_account_provisioning_dir || return 1
    /bin/sync
}

cleanup_interrupted_account_provisioning() {
    local provisioned_id="$1"
    local conflicting_user
    local conflicting_group

    record_id_matches_or_is_unset \
        "/Users/${STAGED_SENSOR_USER}" "UniqueID" "$provisioned_id" \
        && record_id_matches_or_is_unset \
            "/Users/${STAGED_SENSOR_USER}" "PrimaryGroupID" "$provisioned_id" \
        && record_id_matches_or_is_unset \
            "/Groups/${STAGED_SENSOR_GROUP}" "PrimaryGroupID" "$provisioned_id" \
        && record_id_matches_or_is_unset \
            "/Groups/${SENSOR_GROUP}" "PrimaryGroupID" "$provisioned_id" \
        || return 1
    conflicting_user=$(
        /usr/bin/dscl . -list /Users UniqueID 2>/dev/null \
            | /usr/bin/awk \
                -v id="$provisioned_id" \
                -v staged="$STAGED_SENSOR_USER" \
                '$2 == id && $1 != staged { print $1 }'
    ) || return 1
    conflicting_group=$(
        /usr/bin/dscl . -list /Groups PrimaryGroupID 2>/dev/null \
            | /usr/bin/awk \
                -v id="$provisioned_id" \
                -v staged="$STAGED_SENSOR_GROUP" \
                -v final="$SENSOR_GROUP" \
                '$2 == id && $1 != staged && $1 != final { print $1 }'
    ) || return 1
    [ -z "$conflicting_user" ] && [ -z "$conflicting_group" ] \
        || return 1

    SENSOR_UID="$provisioned_id"
    terminate_sensor_processes || return 1
    /usr/bin/crontab -u "$STAGED_SENSOR_USER" -r >/dev/null 2>&1 || true
    for record in \
        "/Users/${STAGED_SENSOR_USER}" \
        "/Groups/${STAGED_SENSOR_GROUP}" \
        "/Groups/${SENSOR_GROUP}"
    do
        if /usr/bin/dscl . -read "$record" >/dev/null 2>&1; then
            /usr/bin/dscl . -delete "$record" || return 1
        fi
    done
}

create_service_account() {
    local new_id=""
    local user_ids
    local group_ids
    if ! cleanup_interrupted_account_deprovisioning; then
        echo "[postinstall] Interrupted service-account removal is unsafe." >&2
        return 1
    fi
    if /usr/bin/dscl . -read "/Users/${SENSOR_USER}" >/dev/null 2>&1; then
        if ! validate_service_identity; then
            echo "[postinstall] Existing service account identity is unsafe." >&2
            return 1
        fi
        if /usr/bin/dscl . -read "/Users/${STAGED_SENSOR_USER}" \
                >/dev/null 2>&1 \
            || /usr/bin/dscl . -read "/Groups/${STAGED_SENSOR_GROUP}" \
                >/dev/null 2>&1
        then
            echo "[postinstall] Unexpected staged service-account records remain." >&2
            return 1
        fi
        if [ -e "$ACCOUNT_PROVISIONING_MARKER" ] \
            || [ -L "$ACCOUNT_PROVISIONING_MARKER" ]
        then
            [ "$(read_account_provisioning_id)" = "$SENSOR_UID" ] \
                || return 1
            retire_account_provisioning_marker || return 1
        fi
        echo "[postinstall] Service account ${SENSOR_USER} already exists (uid/gid ${SENSOR_UID})."
        return
    fi

    if [ -e "$ACCOUNT_PROVISIONING_MARKER" ] \
        || [ -L "$ACCOUNT_PROVISIONING_MARKER" ]
    then
        new_id=$(read_account_provisioning_id) || return 1
        cleanup_interrupted_account_provisioning "$new_id" || return 1
    else
        if /usr/bin/dscl . -read "/Groups/${SENSOR_GROUP}" \
            >/dev/null 2>&1 \
            || /usr/bin/dscl . -read "/Users/${STAGED_SENSOR_USER}" \
                >/dev/null 2>&1 \
            || /usr/bin/dscl . -read "/Groups/${STAGED_SENSOR_GROUP}" \
                >/dev/null 2>&1
        then
            echo "[postinstall] Refusing untrusted partial service-account records." >&2
            return 1
        fi
        user_ids=$(
            /usr/bin/dscl . -list /Users UniqueID 2>/dev/null \
                | /usr/bin/awk 'NF == 2 { print $2 }'
        ) || return 1
        group_ids=$(
            /usr/bin/dscl . -list /Groups PrimaryGroupID 2>/dev/null \
                | /usr/bin/awk 'NF == 2 { print $2 }'
        ) || return 1
        for candidate in $(seq 300 499); do
            if ! printf '%s\n' "$user_ids" \
                    | /usr/bin/grep -qx "$candidate" \
                && ! printf '%s\n' "$group_ids" \
                    | /usr/bin/grep -qx "$candidate"
            then
                new_id="$candidate"
                break
            fi
        done
        if [ -z "$new_id" ] \
            || ! write_account_provisioning_id "$new_id"
        then
            echo "[postinstall] No safe dedicated service UID/GID is available." >&2
            return 1
        fi
    fi

    echo "[postinstall] Creating staged service account ${SENSOR_USER}..."
    /usr/bin/dscl . -create "/Groups/${STAGED_SENSOR_GROUP}"
    /usr/bin/dscl . -create \
        "/Groups/${STAGED_SENSOR_GROUP}" PrimaryGroupID "$new_id"
    /usr/bin/dscl . -create "/Users/${STAGED_SENSOR_USER}"
    /usr/bin/dscl . -create \
        "/Users/${STAGED_SENSOR_USER}" RealName "SquirrelOps Sensor"
    /usr/bin/dscl . -create \
        "/Users/${STAGED_SENSOR_USER}" UserShell /usr/bin/false
    /usr/bin/dscl . -create \
        "/Users/${STAGED_SENSOR_USER}" UniqueID "$new_id"
    /usr/bin/dscl . -create \
        "/Users/${STAGED_SENSOR_USER}" PrimaryGroupID "$new_id"
    /usr/bin/dscl . -create \
        "/Users/${STAGED_SENSOR_USER}" NFSHomeDirectory /var/empty
    /usr/bin/dscl . -create \
        "/Users/${STAGED_SENSOR_USER}" IsHidden 1

    # Commit the group name first and the user name last. Seeing the final user
    # therefore implies every required identity field and matching group were
    # already staged, even if installation is interrupted between commands.
    /usr/bin/dscl . -change \
        "/Groups/${STAGED_SENSOR_GROUP}" RecordName \
        "$STAGED_SENSOR_GROUP" "$SENSOR_GROUP"
    /usr/bin/dscl . -change \
        "/Users/${STAGED_SENSOR_USER}" RecordName \
        "$STAGED_SENSOR_USER" "$SENSOR_USER"
    if ! validate_service_identity; then
        echo "[postinstall] Created service account failed identity validation." >&2
        return 1
    fi
    retire_account_provisioning_marker || return 1
    echo "[postinstall] Created ${SENSOR_USER} (uid/gid ${SENSOR_UID})."
}

sensor_processes_are_running() {
    /usr/bin/pgrep -u "$SENSOR_UID" '.*' >/dev/null 2>&1 \
        || /usr/bin/pgrep -U "$SENSOR_UID" '.*' >/dev/null 2>&1
}

terminate_sensor_processes() {
    local attempts=0
    if ! sensor_processes_are_running; then
        return 0
    fi

    /usr/bin/pkill -TERM -u "$SENSOR_UID" '.*' >/dev/null 2>&1 || true
    /usr/bin/pkill -TERM -U "$SENSOR_UID" '.*' >/dev/null 2>&1 || true
    while sensor_processes_are_running && [ "$attempts" -lt 5 ]; do
        sleep 1
        attempts=$((attempts + 1))
    done
    if sensor_processes_are_running; then
        /usr/bin/pkill -KILL -u "$SENSOR_UID" '.*' >/dev/null 2>&1 || true
        /usr/bin/pkill -KILL -U "$SENSOR_UID" '.*' >/dev/null 2>&1 || true
    fi
    attempts=0
    while sensor_processes_are_running && [ "$attempts" -lt 5 ]; do
        sleep 1
        attempts=$((attempts + 1))
    done
    ! sensor_processes_are_running
}

remove_sensor_crontab() {
    if /usr/bin/crontab -u "$SENSOR_USER" -l >/dev/null 2>&1; then
        /usr/bin/crontab -u "$SENSOR_USER" -r >/dev/null 2>&1 \
            || return 1
    fi
    ! /usr/bin/crontab -u "$SENSOR_USER" -l >/dev/null 2>&1
}

if ! create_service_account; then
    echo "[postinstall] Cannot establish the dedicated sensor service account." >&2
    exit 1
fi
RUN_AS_SERVICE_ACCOUNT=1

validate_mutable_tree() {
    local root="$1"
    [ -d "$root" ] && [ ! -L "$root" ] || return 1
    path_has_no_extended_acl "$root" || return 1

    /usr/bin/find "$root" -xdev -mindepth 1 -print0 \
        | while IFS= read -r -d '' entry; do
            local metadata
            local owner
            local group
            local kind
            local links

            [ ! -L "$entry" ] || return 1
            path_has_no_extended_acl "$entry" || return 1
            metadata=$(
                /usr/bin/stat -f '%Su|%Sg|%HT|%l' "$entry" 2>/dev/null
            ) || return 1
            IFS='|' read -r owner group kind links <<< "$metadata"
            [ "$owner" = "$SENSOR_USER" ] \
                && [ "$group" = "$SENSOR_GROUP" ] \
                || return 1
            case "$kind" in
                Directory) ;;
                "Regular File")
                    [ "$links" = "1" ] || return 1
                    ;;
                *) return 1 ;;
            esac
        done
}

path_has_no_extended_acl() {
    local path="$1"
    /bin/ls -lde "$path" 2>/dev/null \
        | /usr/bin/awk '
            NR > 1 { extra = 1 }
            END { exit !(NR == 1 && extra == 0) }
        '
}

strip_validated_mutable_tree_acls() {
    local root="$1"
    /usr/bin/find "$root" -xdev -mindepth 1 -print0 \
        | while IFS= read -r -d '' entry; do
            local metadata
            local owner
            local group
            local kind
            local links

            [ ! -L "$entry" ] || return 1
            metadata=$(
                /usr/bin/stat -f '%Su|%Sg|%HT|%l' "$entry" 2>/dev/null
            ) || return 1
            IFS='|' read -r owner group kind links <<< "$metadata"
            [ "$owner" = "$SENSOR_USER" ] \
                && [ "$group" = "$SENSOR_GROUP" ] \
                || return 1
            case "$kind" in
                Directory) ;;
                "Regular File")
                    [ "$links" = "1" ] || return 1
                    ;;
                *) return 1 ;;
            esac
            /bin/chmod -N "$entry" || return 1
            path_has_no_extended_acl "$entry" || return 1
        done
}

quarantine_mutable_root() {
    local root="$1"
    if [ -L "$root" ] \
        || { [ -e "$root" ] && [ ! -d "$root" ]; }
    then
        return 1
    fi
    if [ ! -e "$root" ] \
        && ! /usr/bin/install -d -o root -g wheel -m 700 "$root"
    then
        return 1
    fi
    if ! /usr/sbin/chown root:wheel "$root" \
        || ! /bin/chmod -N "$root" \
        || ! /bin/chmod 700 "$root"
    then
        return 1
    fi
    [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp' "$root")" = "root:wheel:700" ] \
        && path_has_no_extended_acl "$root" \
        && strip_validated_mutable_tree_acls "$root"
}

# ---------------------------------------------------------------------------
# Step 1: Create data directories
# ---------------------------------------------------------------------------
echo "[postinstall] Creating data directories..."
if ! terminate_sensor_processes; then
    echo "[postinstall] Processes remain under the sensor service UID." >&2
    exit 1
fi
if ! quarantine_mutable_root "$DATA_DIR" \
    || ! quarantine_mutable_root "$LOG_DIR"
then
    echo "[postinstall] Cannot quarantine mutable sensor storage." >&2
    exit 1
fi
if ! remove_sensor_crontab || ! terminate_sensor_processes; then
    echo "[postinstall] Sensor UID persistence could not be quiesced." >&2
    exit 1
fi
if ! validate_mutable_tree "$DATA_DIR" \
    || ! validate_mutable_tree "$LOG_DIR"
then
    echo "[postinstall] Mutable sensor storage contains unsafe ownership, links, or file types." >&2
    exit 1
fi
if [ -L "$INSTALL_DIR/run" ]; then
    echo "[postinstall] Sensor runtime directory has an unsafe file type." >&2
    exit 1
fi
rm -rf -- "$INSTALL_DIR/run"
if ! /usr/bin/install -d -o root -g wheel -m 755 "$INSTALL_DIR/run"; then
    echo "[postinstall] Cannot create the sensor runtime directory." >&2
    exit 1
fi

validate_known_regular_file() {
    local path="$1"
    local metadata
    local owner
    local group
    local kind
    local links

    [ -e "$path" ] || { [ ! -L "$path" ] && return 0; }
    [ ! -L "$path" ] || return 1
    metadata=$(
        /usr/bin/stat -f '%Su|%Sg|%HT|%l' "$path" 2>/dev/null
    ) || return 1
    IFS='|' read -r owner group kind links <<< "$metadata"
    [ "$kind" = "Regular File" ] && [ "$links" = "1" ] || return 1
    { [ "$owner" = "root" ] && [ "$group" = "wheel" ]; } \
        || { [ "$owner" = "$SENSOR_USER" ] \
            && [ "$group" = "$SENSOR_GROUP" ]; }
}

# ---------------------------------------------------------------------------
# Step 2: Handle config file
# ---------------------------------------------------------------------------
if ! validate_known_regular_file "$CONFIG_FILE" \
    || ! validate_known_regular_file "$CONFIG_BACKUP"
then
    echo "[postinstall] Sensor configuration path has unsafe ownership, links, or file type." >&2
    exit 1
fi
if [ -f "$CONFIG_BACKUP" ]; then
    # Upgrade path: restore backed-up config
    echo "[postinstall] Restoring config from backup..."
    if ! /bin/mv -fh "$CONFIG_BACKUP" "$CONFIG_FILE"; then
        echo "[postinstall] Cannot restore the verified configuration backup." >&2
        exit 1
    fi
elif [ ! -f "$CONFIG_FILE" ]; then
    # Fresh install: generate default config
    echo "[postinstall] Generating default config.yaml..."
    cat > "$CONFIG_FILE" << YAML
# SquirrelOps Home Sensor — Configuration
# See documentation for all available options.

profile: standard

sensor:
  name: SquirrelOps Home Sensor
  data_dir: "$DATA_DIR"
  port: 8443

network:
  interface: auto
  scan_interval: 300

alerts:
  retention_days: 90

pairing:
  socket_path: "$INSTALL_DIR/run/pairing.sock"
  local_enrollment_enabled: true
YAML
fi

# Existing package installs predate helper-mediated enrollment. Add the new
# setting only when it is absent, preserving an operator's explicit false.
local_enrollment_setting_present() {
    isolated_python - "$CONFIG_FILE" <<'PY'
import sys
from pathlib import Path

import yaml

config = yaml.safe_load(Path(sys.argv[1]).read_text())
pairing = config.get("pairing") if isinstance(config, dict) else None
if not isinstance(pairing, dict):
    raise SystemExit(1)
value = pairing.get("local_enrollment_enabled")
raise SystemExit(0 if isinstance(value, bool) else 1)
PY
}

if ! local_enrollment_setting_present
then
    if ! CONFIG_MIGRATION_TEMP=$(
        /usr/bin/mktemp "$INSTALL_DIR/.config.yaml.XXXXXXXX"
    ); then
        echo "[postinstall] Cannot stage the local enrollment configuration." >&2
        exit 1
    fi
    if ! /usr/bin/awk '
        BEGIN { in_pairing = 0; saw_pairing = 0; inserted = 0 }
        /^[^[:space:]#][^:]*:[[:space:]]*($|#)/ {
            if (in_pairing && !inserted) {
                print "  local_enrollment_enabled: true"
                inserted = 1
            }
            in_pairing = 0
        }
        /^pairing:[[:space:]]*($|#)/ {
            in_pairing = 1
            saw_pairing = 1
        }
        /^pairing:[[:space:]]*\{.*\}[[:space:]]*(#.*)?$/ {
            closing = match($0, /}[[:space:]]*(#.*)?$/)
            prefix = substr($0, 1, closing - 1)
            suffix = substr($0, closing + 1)
            separator = prefix ~ /\{[[:space:]]*$/ ? "" : ","
            $0 = prefix separator " local_enrollment_enabled: true}" suffix
            saw_pairing = 1
            inserted = 1
        }
        { print }
        END {
            if (in_pairing && !inserted) {
                print "  local_enrollment_enabled: true"
                inserted = 1
            }
            if (!saw_pairing) {
                print ""
                print "pairing:"
                print "  local_enrollment_enabled: true"
            }
        }
    ' "$CONFIG_FILE" > "$CONFIG_MIGRATION_TEMP" \
        || ! /bin/chmod 600 "$CONFIG_MIGRATION_TEMP"
    then
        echo "[postinstall] Cannot add the local enrollment configuration." >&2
        exit 1
    fi
    if ! isolated_python - "$CONFIG_FILE" "$CONFIG_MIGRATION_TEMP" <<'PY'
import copy
import sys
from pathlib import Path

import yaml

original = yaml.safe_load(Path(sys.argv[1]).read_text())
config = yaml.safe_load(Path(sys.argv[2]).read_text())
if not isinstance(original, dict) or not isinstance(config, dict):
    raise SystemExit("configuration is not a mapping")
expected = copy.deepcopy(original)
pairing = expected.setdefault("pairing", {})
if not isinstance(pairing, dict):
    raise SystemExit("pairing configuration is not a mapping")
pairing["local_enrollment_enabled"] = True
if config != expected:
    raise SystemExit("migration changed existing configuration")
if config["pairing"].get("local_enrollment_enabled") is not True:
    raise SystemExit("local enrollment setting was not added")
PY
    then
        echo "[postinstall] Migrated local enrollment configuration is invalid." >&2
        exit 1
    fi
    if ! /bin/mv -fh "$CONFIG_MIGRATION_TEMP" "$CONFIG_FILE"; then
        echo "[postinstall] Cannot install the local enrollment configuration." >&2
        exit 1
    fi
    CONFIG_MIGRATION_TEMP=""
fi

# ---------------------------------------------------------------------------
# Step 3: Install launchd plist from template
# ---------------------------------------------------------------------------
echo "[postinstall] Installing launchd plist..."

if [ -L "$PLIST_TEMPLATE" ] || [ ! -f "$PLIST_TEMPLATE" ] \
    || [ "$(/usr/bin/stat -f '%Su:%Sg:%HT:%l' "$PLIST_TEMPLATE")" \
        != "root:wheel:Regular File:1" ]
then
    echo "[postinstall] Plist template is missing or unsafe at $PLIST_TEMPLATE." >&2
    exit 1
fi
if [ -L "/Library/LaunchDaemons" ] \
    || [ ! -d "/Library/LaunchDaemons" ] \
    || [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp' /Library/LaunchDaemons)" \
        != "root:wheel:755" ]
then
    echo "[postinstall] LaunchDaemon directory is unsafe." >&2
    exit 1
fi
if ! PLIST_TEMP=$(
    /usr/bin/mktemp \
        "/Library/LaunchDaemons/.${PLIST_NAME}.plist.XXXXXXXX"
); then
    echo "[postinstall] Cannot stage the sensor launchd plist." >&2
    exit 1
fi
if ! sed \
        -e "s|__PYTHON_PATH__|${PYTHON_PATH}|g" \
        -e "s|__CONFIG_PATH__|${CONFIG_FILE}|g" \
        -e "s|__INSTALL_DIR__|${INSTALL_DIR}|g" \
        -e "s|__DATA_DIR__|${DATA_DIR}|g" \
        -e "s|__LOG_DIR__|${LOG_DIR}|g" \
        "$PLIST_TEMPLATE" > "$PLIST_TEMP"
then
    echo "[postinstall] Cannot render the sensor launchd plist." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Step 3b: Run the daemon as the non-root service account
# ---------------------------------------------------------------------------
# The plist template carries no UserName (it is shared with the per-user
# LaunchAgent install). For the root .pkg deployment we inject it here and give
# the account ownership of the directories it must read/write.
set_launchd_identity() {
    local key="$1"
    local expected_value="$2"
    local actual_value

    if ! /usr/libexec/PlistBuddy \
        -c "Add :${key} string ${expected_value}" "$PLIST_TEMP" 2>/dev/null
    then
        if ! /usr/libexec/PlistBuddy \
            -c "Set :${key} ${expected_value}" "$PLIST_TEMP" 2>/dev/null
        then
            echo "[postinstall] Cannot set launchd ${key} to ${expected_value}." >&2
            return 1
        fi
    fi

    if ! actual_value=$(
        /usr/libexec/PlistBuddy -c "Print :${key}" "$PLIST_TEMP" 2>/dev/null
    ); then
        echo "[postinstall] Cannot verify launchd ${key}." >&2
        return 1
    fi
    if [ "$actual_value" != "$expected_value" ]; then
        echo "[postinstall] launchd ${key} is ${actual_value}, expected ${expected_value}." >&2
        return 1
    fi
}

verify_owner_mode() {
    local path="$1"
    local expected_mode="$2"
    local expected_value="${SENSOR_USER}:${SENSOR_GROUP}:${expected_mode}"
    local actual_value

    if ! actual_value=$(/usr/bin/stat -f "%Su:%Sg:%Lp" "$path" 2>/dev/null); then
        echo "[postinstall] Cannot inspect ownership and mode for ${path}." >&2
        return 1
    fi
    if [ "$actual_value" != "$expected_value" ]; then
        echo "[postinstall] ${path} is ${actual_value}, expected ${expected_value}." >&2
        return 1
    fi
}

verify_existing_log_permissions() {
    find "$LOG_DIR" -maxdepth 1 -type f -exec /bin/sh -c '
        expected_value="$1"
        shift
        for log_file do
            if ! actual_value=$(/usr/bin/stat -f "%Su:%Sg:%Lp" "$log_file" 2>/dev/null); then
                echo "[postinstall] Cannot inspect log permissions for ${log_file}." >&2
                exit 1
            fi
            if [ "$actual_value" != "$expected_value" ]; then
                echo "[postinstall] ${log_file} is ${actual_value}, expected ${expected_value}." >&2
                exit 1
            fi
        done
    ' sh "${SENSOR_USER}:${SENSOR_GROUP}:600" {} +
}

configure_sensor_permissions() {
    # The sensor writes the DB, certs, secret store, and logs; the standalone
    # Python runtime stays root-owned and read+execute only. Mutable trees were
    # quarantined and validated before these top-level ownership transitions;
    # never recursively chown attacker-controlled entries.
    if ! /usr/sbin/chown "${SENSOR_USER}:${SENSOR_GROUP}" \
        "$DATA_DIR" "$INSTALL_DIR/run" "$CONFIG_FILE"
    then
        return 1
    fi
    if ! /bin/chmod 700 "$DATA_DIR"; then
        return 1
    fi
    if ! /bin/chmod 700 "$LOG_DIR"; then
        return 1
    fi
    if ! /bin/chmod 755 "$INSTALL_DIR/run"; then
        return 1
    fi
    if ! /bin/chmod 600 "$CONFIG_FILE"; then
        return 1
    fi
    # The top-level directory remains root-owned and mode 700 while this walk
    # runs, so the validated paths cannot be replaced by the service account.
    if ! /usr/bin/find "$LOG_DIR" -xdev -maxdepth 1 -type f \
        -exec /bin/chmod 600 {} \;
    then
        return 1
    fi
    if ! /usr/sbin/chown "${SENSOR_USER}:${SENSOR_GROUP}" "$LOG_DIR"; then
        return 1
    fi

    verify_owner_mode "$DATA_DIR" "700" \
        && verify_owner_mode "$LOG_DIR" "700" \
        && verify_owner_mode "$INSTALL_DIR/run" "755" \
        && verify_owner_mode "$CONFIG_FILE" "600" \
        && verify_existing_log_permissions
}

if [ "$RUN_AS_SERVICE_ACCOUNT" = "1" ]; then
    echo "[postinstall] Configuring daemon to run as ${SENSOR_USER}..."
    if ! set_launchd_identity "UserName" "$SENSOR_USER"; then
        echo "[postinstall] Cannot configure the required launchd service identity." >&2
        exit 1
    fi
    if ! set_launchd_identity "GroupName" "$SENSOR_GROUP"; then
        echo "[postinstall] Cannot configure the required launchd service identity." >&2
        exit 1
    fi
    if ! configure_sensor_permissions; then
        echo "[postinstall] Cannot configure required sensor storage permissions." >&2
        exit 1
    fi
fi

if ! /usr/bin/plutil -lint "$PLIST_TEMP" >/dev/null \
    || ! /usr/sbin/chown root:wheel "$PLIST_TEMP" \
    || ! /bin/chmod 644 "$PLIST_TEMP" \
    || ! /bin/mv -fh "$PLIST_TEMP" "$PLIST_DEST"
then
    echo "[postinstall] Cannot install the verified sensor launchd plist." >&2
    exit 1
fi
PLIST_TEMP=""
if [ -L "$PLIST_DEST" ] || [ ! -f "$PLIST_DEST" ] \
    || [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp:%l' "$PLIST_DEST")" \
        != "root:wheel:644:1" ]
then
    echo "[postinstall] Installed sensor launchd plist is unsafe." >&2
    exit 1
fi

# The app package starts the helper before the service account exists. Restart
# it now, then prove the actual sensor account can connect to the RPC socket.
verify_helper_for_sensor_account() {
    [ -x "$HELPER_BINARY" ] \
        && [ -f "$HELPER_PLIST" ] \
        && [ -S "$HELPER_SOCKET" ] \
        && /usr/bin/sudo -n -u "$SENSOR_USER" /usr/bin/env -i \
            PATH=/usr/bin:/bin:/usr/sbin:/sbin \
            LC_ALL=C \
            "$PYTHON_PATH" -I - "$HELPER_SOCKET" >/dev/null 2>&1 <<'PY'
import json
import socket
import sys

request = {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "ping",
}
required_capabilities = {
    "arp_scan",
    "virtual_ip",
    "port_forward_isolation",
}

with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as helper:
    helper.settimeout(2)
    helper.connect(sys.argv[1])
    helper.sendall(json.dumps(request, separators=(",", ":")).encode() + b"\n")
    response_line = helper.makefile("rb").readline(65537)

if not response_line.endswith(b"\n") or len(response_line) > 65536:
    raise SystemExit(1)
response = json.loads(response_line)
result = response.get("result")
valid = (
    response.get("jsonrpc") == "2.0"
    and response.get("id") == 1
    and "error" not in response
    and isinstance(result, dict)
    and result.get("status") == "ok"
    and result.get("protocol_version") == 1
    and required_capabilities.issubset(result.get("capabilities", []))
)
raise SystemExit(0 if valid else 1)
PY
}

if [ ! -x "$HELPER_BINARY" ] || [ ! -f "$HELPER_PLIST" ]; then
    echo "[postinstall] Privileged helper installation is incomplete." >&2
    exit 1
fi
if ! terminate_sensor_processes; then
    echo "[postinstall] Sensor UID process reappeared before helper restart." >&2
    exit 1
fi
if ! launchctl kickstart -k "system/${HELPER_LABEL}" 2>/dev/null; then
    echo "[postinstall] Failed to restart privileged helper." >&2
    exit 1
fi

HELPER_WAIT=0
while ! verify_helper_for_sensor_account; do
    if [ "$HELPER_WAIT" -ge 10 ]; then
        echo "[postinstall] Privileged helper is unusable by ${SENSOR_USER}." >&2
        exit 1
    fi
    sleep 1
    HELPER_WAIT=$((HELPER_WAIT + 1))
done
echo "[postinstall] Privileged helper is available to ${SENSOR_USER}."

# ---------------------------------------------------------------------------
# Step 5: Load the sensor service
# ---------------------------------------------------------------------------
echo "[postinstall] Loading sensor service..."
if ! launchctl bootstrap system "$PLIST_DEST" 2>/dev/null; then
    echo "[postinstall] Failed to bootstrap sensor service." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Step 6: Prove launchd accepted the sensor and owns its continued startup
# ---------------------------------------------------------------------------
echo "[postinstall] Waiting for sensor to start..."

HEALTH_URL="https://localhost:8443/system/health"
# PackageKit terminates a component script after 600 seconds. A Full-profile
# upgrade can safely restore persisted fake hosts for longer than that. Prove
# that launchd owns a stable process, accept an early healthy API when one is
# available, and leave long recovery under the service supervisor.
STARTUP_HANDOFF_TIMEOUT_SECONDS=45
HEALTH_PROBE_TIMEOUT_SECONDS=3
STARTUP_HANDOFF_INTERVAL_SECONDS=1
HEALTH_REQUIRED_SUCCESSES=2
SENSOR_LIVENESS_GRACE_SECONDS=10
SENSOR_STABILITY_REQUIRED_SECONDS=10
HEALTH_STARTED_AT="$(/bin/date "+%s")"
STARTUP_HANDOFF_DEADLINE=$((HEALTH_STARTED_AT + STARTUP_HANDOFF_TIMEOUT_SECONDS))
SENSOR_LIVENESS_GRACE_DEADLINE=$((HEALTH_STARTED_AT + SENSOR_LIVENESS_GRACE_SECONDS))
SENSOR_SERVICE_SNAPSHOT=""
SENSOR_HEALTHY=0
SENSOR_STABLE_PID=""
SENSOR_STABLE_STARTED_AT=0

capture_sensor_service_snapshot() {
    SENSOR_SERVICE_SNAPSHOT=$(
        /bin/launchctl print "system/${PLIST_NAME}" 2>/dev/null
    )
}

sensor_service_is_running() {
    printf '%s\n' "$SENSOR_SERVICE_SNAPSHOT" \
        | /usr/bin/grep -Eq "state = running" \
        && printf '%s\n' "$SENSOR_SERVICE_SNAPSHOT" \
        | /usr/bin/grep -Eq "pid = [1-9][0-9]*"
}

sensor_service_pid() {
    printf '%s\n' "$SENSOR_SERVICE_SNAPSHOT" \
        | /usr/bin/sed -n 's/^[[:space:]]*pid = \([1-9][0-9]*\)$/\1/p' \
        | /usr/bin/head -n 1
}

sensor_health_is_ready() {
    local health_response

    # The local API uses a self-signed certificate. A successful HTTP status
    # alone is insufficient: require the sensor's documented health payload.
    if ! health_response=$(
        /usr/bin/curl \
            --silent \
            --show-error \
            --fail \
            --insecure \
            --connect-timeout 1 \
            --max-time "$HEALTH_PROBE_TIMEOUT_SECONDS" \
            "$HEALTH_URL" 2>/dev/null
    ); then
        return 1
    fi

    printf '%s' "$health_response" | isolated_python -c '
import json
import sys

try:
    payload = json.load(sys.stdin)
except (json.JSONDecodeError, UnicodeDecodeError):
    raise SystemExit(1)

healthy = isinstance(payload, dict) and payload.get("status") == "ok"
raise SystemExit(0 if healthy else 1)
'
}

wait_for_sensor_handoff() {
    local consecutive_successes=0
    local now
    local sensor_pid
    local remaining
    local sleep_seconds

    while [ "$(/bin/date "+%s")" -lt "$STARTUP_HANDOFF_DEADLINE" ]; do
        if ! capture_sensor_service_snapshot; then
            echo "[postinstall] Sensor launchd job disappeared during startup." >&2
            return 1
        fi

        now="$(/bin/date "+%s")"
        if sensor_service_is_running; then
            sensor_pid="$(sensor_service_pid)"
            if [ -n "$sensor_pid" ] && [ "$sensor_pid" = "$SENSOR_STABLE_PID" ]; then
                if [ $((now - SENSOR_STABLE_STARTED_AT)) -ge "$SENSOR_STABILITY_REQUIRED_SECONDS" ]; then
                    return 0
                fi
            else
                SENSOR_STABLE_PID="$sensor_pid"
                SENSOR_STABLE_STARTED_AT="$now"
            fi

            if sensor_health_is_ready; then
                consecutive_successes=$((consecutive_successes + 1))
                if [ "$consecutive_successes" -ge "$HEALTH_REQUIRED_SUCCESSES" ]; then
                    SENSOR_HEALTHY=1
                    return 0
                fi
            else
                consecutive_successes=0
            fi
        elif [ "$now" -ge "$SENSOR_LIVENESS_GRACE_DEADLINE" ]; then
            echo "[postinstall] Sensor process is not running." >&2
            return 1
        else
            consecutive_successes=0
            SENSOR_STABLE_PID=""
            SENSOR_STABLE_STARTED_AT=0
        fi

        now="$(/bin/date "+%s")"
        remaining=$((STARTUP_HANDOFF_DEADLINE - now))
        if [ "$remaining" -le 0 ]; then
            break
        fi
        sleep_seconds="$STARTUP_HANDOFF_INTERVAL_SECONDS"
        if [ "$remaining" -lt "$sleep_seconds" ]; then
            sleep_seconds="$remaining"
        fi
        /bin/sleep "$sleep_seconds"
    done

    return 1
}

if wait_for_sensor_handoff; then
    if [ "$SENSOR_HEALTHY" -eq 1 ]; then
        echo "[postinstall] Sensor is healthy."
    else
        echo "[postinstall] Sensor initialization continues under launchd."
    fi
else
    echo "[postinstall] Sensor did not remain stable during startup handoff." >&2
    echo "[postinstall] Check logs at: $LOG_DIR/squirrelops-sensor.log" >&2
    exit 1
fi

echo "[postinstall] Done."
exit 0
