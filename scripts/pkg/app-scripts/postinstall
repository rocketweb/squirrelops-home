#!/usr/bin/env bash
#
# SquirrelOps Home — App Package Postinstall Script
#
# Runs after app payload extraction. Installs the privileged helper daemon
# that provides root-level ARP scanning, virtual-IP management, and packet
# filter isolation to the unprivileged sensor process.
#
# This script runs as root during .pkg installation.
#
set -euo pipefail

APP_PATH="/Applications/SquirrelOps Home.app"
HELPER_BUNDLE_ID="com.squirrelops.helper"
EXPECTED_TEAM_ID="PSQ5HK5U65"
HELPER_SRC="$APP_PATH/Contents/Library/LaunchServices/$HELPER_BUNDLE_ID"
HELPER_DEST="/Library/PrivilegedHelperTools/$HELPER_BUNDLE_ID"
PLIST_DEST="/Library/LaunchDaemons/${HELPER_BUNDLE_ID}.plist"
HELPER_STATE_DIR="/var/db/com.squirrelops.helper"
HELPER_REQUIREMENT="identifier \"${HELPER_BUNDLE_ID}\" and anchor apple generic and certificate leaf[subject.OU] = \"${EXPECTED_TEAM_ID}\""
LOCAL_TEST_MARKER="$APP_PATH/Contents/Resources/com.squirrelops.local-test-build"
LOCAL_TEST_OPT_IN="/var/db/com.squirrelops.allow-local-test"
LOCAL_TEST_BUILD=0
HELPER_TEMP=""
PLIST_TEMP=""

cleanup_staged_files() {
    if [ -n "$HELPER_TEMP" ]; then
        rm -f -- "$HELPER_TEMP"
    fi
    if [ -n "$PLIST_TEMP" ]; then
        rm -f -- "$PLIST_TEMP"
    fi
}
trap cleanup_staged_files EXIT

path_has_no_extended_acl() {
    local path="$1"
    /bin/ls -lde "$path" 2>/dev/null \
        | /usr/bin/awk '
            NR > 1 { extra = 1 }
            END { exit !(NR == 1 && extra == 0) }
        '
}

if [ -e "$LOCAL_TEST_MARKER" ]; then
    if [ -L "$LOCAL_TEST_MARKER" ] || [ ! -f "$LOCAL_TEST_MARKER" ] \
        || ! /usr/bin/codesign --verify --deep --strict --verbose=2 "$APP_PATH"
    then
        echo "[app-postinstall] Local test marker or app signature is invalid." >&2
        exit 1
    fi
    if ! APP_SIGNATURE=$(
        /usr/bin/codesign -d --verbose=4 "$APP_PATH" 2>&1
    ) || ! printf '%s\n' "$APP_SIGNATURE" \
        | /usr/bin/grep -Fxq 'Signature=adhoc'
    then
        echo "[app-postinstall] Local test build must use an ad-hoc app signature." >&2
        exit 1
    fi
    if [ -L "$LOCAL_TEST_OPT_IN" ] || [ ! -f "$LOCAL_TEST_OPT_IN" ] \
        || [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp:%l' "$LOCAL_TEST_OPT_IN")" \
            != "root:wheel:600:1" ] \
        || ! path_has_no_extended_acl "$LOCAL_TEST_OPT_IN"
    then
        echo "[app-postinstall] Local test builds require a one-time root-owned operator opt-in." >&2
        echo "[app-postinstall] Create it before retrying: sudo /usr/bin/install -o root -g wheel -m 600 /dev/null $LOCAL_TEST_OPT_IN" >&2
        exit 1
    fi
    # Consume the opt-in the moment it authorizes this run, not after the
    # install succeeds. Every later step can fail, and each of those exits
    # would otherwise leave the opt-in armed for an install the operator never
    # authorized. The token's job is to permit one attempt, not one success.
    if ! /bin/rm -f -- "$LOCAL_TEST_OPT_IN"; then
        echo "[app-postinstall] Could not consume the local test opt-in." >&2
        exit 1
    fi
    if [ -e "$LOCAL_TEST_OPT_IN" ]; then
        echo "[app-postinstall] Local test opt-in survived removal." >&2
        exit 1
    fi
    LOCAL_TEST_BUILD=1
    echo "[app-postinstall] Consumed one-time local test operator opt-in." >&2
    echo "[app-postinstall] Installing explicit ad-hoc local test build." >&2
fi

verify_local_test_helper() {
    local path="$1"
    local signature
    /usr/bin/codesign --verify --strict --verbose=2 "$path" || return 1
    signature=$(/usr/bin/codesign -d --verbose=4 "$path" 2>&1) || return 1
    printf '%s\n' "$signature" \
        | /usr/bin/grep -Fxq "Identifier=${HELPER_BUNDLE_ID}" \
        || return 1
    printf '%s\n' "$signature" \
        | /usr/bin/grep -Fxq 'Signature=adhoc'
}

# ---------------------------------------------------------------------------
# Step 1: Install helper binary
# ---------------------------------------------------------------------------
if [ ! -x "$HELPER_SRC" ]; then
    echo "[app-postinstall] Required helper binary is missing or not executable." >&2
    exit 1
fi

echo "[app-postinstall] Installing privileged helper daemon..."
if [ -L "/Library/PrivilegedHelperTools" ] \
    || { [ -e "/Library/PrivilegedHelperTools" ] \
        && [ ! -d "/Library/PrivilegedHelperTools" ]; }
then
    echo "[app-postinstall] Privileged helper directory is unsafe." >&2
    exit 1
fi
if ! /usr/bin/install -d -o root -g wheel -m 755 \
        /Library/PrivilegedHelperTools \
    || ! /bin/chmod -N /Library/PrivilegedHelperTools \
    || ! path_has_no_extended_acl /Library/PrivilegedHelperTools \
    || [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp' \
        /Library/PrivilegedHelperTools)" != "root:wheel:755" ]
then
    echo "[app-postinstall] Cannot secure the privileged helper directory." >&2
    exit 1
fi
if ! HELPER_TEMP=$(
    /usr/bin/mktemp \
        "/Library/PrivilegedHelperTools/.${HELPER_BUNDLE_ID}.XXXXXXXX"
); then
    echo "[app-postinstall] Cannot stage the privileged helper." >&2
    exit 1
fi
if ! /bin/cp "$HELPER_SRC" "$HELPER_TEMP"; then
    echo "[app-postinstall] Cannot copy the privileged helper." >&2
    exit 1
fi
if ! /usr/sbin/chown root:wheel "$HELPER_TEMP" \
    || ! /bin/chmod 755 "$HELPER_TEMP" \
    || ! /bin/chmod -N "$HELPER_TEMP" \
    || ! path_has_no_extended_acl "$HELPER_TEMP" \
    || [ -L "$HELPER_TEMP" ] || [ ! -f "$HELPER_TEMP" ] \
    || [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp:%l' "$HELPER_TEMP")" \
        != "root:wheel:755:1" ]
then
    echo "[app-postinstall] Cannot secure the staged privileged helper." >&2
    exit 1
fi
if [ "$LOCAL_TEST_BUILD" = "1" ]; then
    if ! verify_local_test_helper "$HELPER_TEMP"; then
        echo "[app-postinstall] Staged local test helper signature is invalid." >&2
        exit 1
    fi
else
    if ! /usr/bin/codesign --verify --strict --verbose=2 \
        -R "=${HELPER_REQUIREMENT}" "$HELPER_TEMP"
    then
        echo "[app-postinstall] Staged helper has an untrusted code signature." >&2
        exit 1
    fi
fi
if ! /bin/mv -fh "$HELPER_TEMP" "$HELPER_DEST"; then
    echo "[app-postinstall] Cannot install the verified helper." >&2
    exit 1
fi
HELPER_TEMP=""
if ! /bin/chmod -N "$HELPER_DEST" \
    || ! path_has_no_extended_acl "$HELPER_DEST" \
    || [ -L "$HELPER_DEST" ] || [ ! -f "$HELPER_DEST" ] \
    || [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp:%l' "$HELPER_DEST")" \
        != "root:wheel:755:1" ]
then
    echo "[app-postinstall] Installed helper ownership or file type is unsafe." >&2
    exit 1
fi
if [ "$LOCAL_TEST_BUILD" = "1" ]; then
    if ! verify_local_test_helper "$HELPER_DEST"; then
        echo "[app-postinstall] Installed local test helper signature verification failed." >&2
        exit 1
    fi
else
    if ! /usr/bin/codesign --verify --strict --verbose=2 \
        -R "=${HELPER_REQUIREMENT}" "$HELPER_DEST"
    then
        echo "[app-postinstall] Installed helper signature verification failed." >&2
        exit 1
    fi
fi
if [ ! -x "$HELPER_DEST" ]; then
    echo "[app-postinstall] Installed helper is not executable." >&2
    exit 1
fi

# Initialize a permanent root-owned marker for the ledger-aware helper. This
# prevents sensor database rows from ever becoming cleanup authority again,
# even before the first virtual IP causes the ledger file itself to be written.
if [ -e "$HELPER_STATE_DIR" ] || [ -L "$HELPER_STATE_DIR" ]; then
    if [ -L "$HELPER_STATE_DIR" ] || [ ! -d "$HELPER_STATE_DIR" ]; then
        echo "[app-postinstall] Helper alias ownership directory has an unsafe file type." >&2
        exit 1
    fi
fi
if ! /usr/bin/install -d -o root -g wheel -m 700 "$HELPER_STATE_DIR" \
    || ! /bin/chmod -N "$HELPER_STATE_DIR" \
    || ! path_has_no_extended_acl "$HELPER_STATE_DIR"
then
    echo "[app-postinstall] Cannot initialize helper alias ownership state." >&2
    exit 1
fi
if [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp' "$HELPER_STATE_DIR")" \
    != "root:wheel:700" ]
then
    echo "[app-postinstall] Helper alias ownership state permissions are unsafe." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Step 2: Install launchd plist
# ---------------------------------------------------------------------------
echo "[app-postinstall] Installing helper launchd plist..."
if [ -L "/Library/LaunchDaemons" ] \
    || [ ! -d "/Library/LaunchDaemons" ] \
    || [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp' /Library/LaunchDaemons)" \
        != "root:wheel:755" ]
then
    echo "[app-postinstall] LaunchDaemon directory is unsafe." >&2
    exit 1
fi
if ! /bin/chmod -N /Library/LaunchDaemons \
    || ! path_has_no_extended_acl /Library/LaunchDaemons
then
    echo "[app-postinstall] Cannot secure the LaunchDaemon directory." >&2
    exit 1
fi
if ! PLIST_TEMP=$(
    /usr/bin/mktemp \
        "/Library/LaunchDaemons/.${HELPER_BUNDLE_ID}.plist.XXXXXXXX"
); then
    echo "[app-postinstall] Cannot stage the helper launchd plist." >&2
    exit 1
fi
/bin/cat > "$PLIST_TEMP" << 'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.squirrelops.helper</string>
    <key>Program</key>
    <string>/Library/PrivilegedHelperTools/com.squirrelops.helper</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/com.squirrelops.helper.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/com.squirrelops.helper.log</string>
</dict>
</plist>
PLIST

if ! /usr/sbin/chown root:wheel "$PLIST_TEMP" \
    || ! /bin/chmod 644 "$PLIST_TEMP" \
    || ! /bin/chmod -N "$PLIST_TEMP" \
    || ! path_has_no_extended_acl "$PLIST_TEMP" \
    || [ -L "$PLIST_TEMP" ] || [ ! -f "$PLIST_TEMP" ] \
    || [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp:%l' "$PLIST_TEMP")" \
        != "root:wheel:644:1" ] \
    || ! /usr/bin/plutil -lint "$PLIST_TEMP" >/dev/null \
    || ! /bin/mv -fh "$PLIST_TEMP" "$PLIST_DEST"
then
    echo "[app-postinstall] Cannot install the verified helper launchd plist." >&2
    exit 1
fi
PLIST_TEMP=""
if ! /bin/chmod -N "$PLIST_DEST" \
    || ! path_has_no_extended_acl "$PLIST_DEST" \
    || [ -L "$PLIST_DEST" ] || [ ! -f "$PLIST_DEST" ] \
    || [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp:%l' "$PLIST_DEST")" \
        != "root:wheel:644:1" ]
then
    echo "[app-postinstall] Installed helper launchd plist is unsafe." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Step 3: Load the helper daemon
# ---------------------------------------------------------------------------
echo "[app-postinstall] Starting helper daemon..."
if ! launchctl bootstrap system "$PLIST_DEST" 2>/dev/null; then
    echo "[app-postinstall] Failed to bootstrap helper daemon." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Step 4: Verify the helper's versioned RPC contract
# ---------------------------------------------------------------------------
SOCKET_PATH="/var/run/squirrelops-helper.sock"
verify_helper_rpc() {
    local response
    local jsonrpc
    local response_id
    local status
    local protocol_version
    local capabilities
    local capability

    [ -S "$SOCKET_PATH" ] || return 1
    if ! response=$(
        printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"ping"}' \
            | /usr/bin/nc -U -w 2 "$SOCKET_PATH" 2>/dev/null
    ); then
        return 1
    fi

    jsonrpc=$(printf '%s\n' "$response" \
        | /usr/bin/plutil -extract jsonrpc raw -o - - 2>/dev/null) \
        || return 1
    response_id=$(printf '%s\n' "$response" \
        | /usr/bin/plutil -extract id raw -o - - 2>/dev/null) \
        || return 1
    status=$(printf '%s\n' "$response" \
        | /usr/bin/plutil -extract result.status raw -o - - 2>/dev/null) \
        || return 1
    protocol_version=$(printf '%s\n' "$response" \
        | /usr/bin/plutil -extract result.protocol_version raw -o - - 2>/dev/null) \
        || return 1
    capabilities=$(printf '%s\n' "$response" \
        | /usr/bin/plutil -extract result.capabilities json -o - - 2>/dev/null) \
        || return 1

    [ "$jsonrpc" = "2.0" ] \
        && [ "$response_id" = "1" ] \
        && [ "$status" = "ok" ] \
        && [ "$protocol_version" = "1" ] \
        || return 1

    for capability in \
        arp_scan \
        virtual_ip \
        port_forward_isolation
    do
        case "$capabilities" in
            *"\"${capability}\""*) ;;
            *) return 1 ;;
        esac
    done
}

ATTEMPTS=0
until verify_helper_rpc; do
    if [ "$ATTEMPTS" -ge 10 ]; then
        echo "[app-postinstall] Helper RPC did not become ready after ${ATTEMPTS} attempts." >&2
        exit 1
    fi
    sleep 1
    ATTEMPTS=$((ATTEMPTS + 1))
done

echo "[app-postinstall] Helper RPC is ready (socket: $SOCKET_PATH)."
echo "[app-postinstall] Done."
exit 0
