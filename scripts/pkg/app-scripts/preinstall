#!/usr/bin/env bash
#
# SquirrelOps Home — App Package Preinstall Script
#
# Runs before app payload extraction. Removes the existing app bundle and
# clears any stale package receipt so the installer places a fresh copy
# in /Applications.
#
# This script runs as root during .pkg installation.
#
set -euo pipefail

PKG_ID="com.squirrelops.home.app"
APP_PATH="/Applications/SquirrelOps Home.app"
SENSOR_LABEL="com.squirrelops.sensor"
SENSOR_PLIST="/Library/LaunchDaemons/${SENSOR_LABEL}.plist"
SENSOR_INSTALL_DIR="/Library/SquirrelOps/sensor"
SENSOR_DB="$SENSOR_INSTALL_DIR/data/squirrelops.db"
HELPER_LABEL="com.squirrelops.helper"
HELPER_PLIST="/Library/LaunchDaemons/${HELPER_LABEL}.plist"
HELPER_BINARY="/Library/PrivilegedHelperTools/${HELPER_LABEL}"

service_is_loaded() {
    local label="$1"
    launchctl print "system/${label}" >/dev/null 2>&1
}

stop_service_and_verify() {
    local label="$1"
    local description="$2"
    local attempts=0

    if ! service_is_loaded "$label"; then
        return 0
    fi

    echo "[app-preinstall] Stopping ${description}..."
    if ! launchctl bootout "system/${label}" 2>/dev/null; then
        if service_is_loaded "$label"; then
            echo "[app-preinstall] Cannot stop ${description}; aborting upgrade." >&2
            return 1
        fi
    fi

    while service_is_loaded "$label"; do
        if [ "$attempts" -ge 10 ]; then
            echo "[app-preinstall] ${description} shutdown could not be verified; aborting upgrade." >&2
            return 1
        fi
        sleep 1
        attempts=$((attempts + 1))
    done
}

EXISTING_SENSOR_INSTALL=0
if [ -f "$SENSOR_PLIST" ] || [ -d "$SENSOR_INSTALL_DIR" ] \
    || service_is_loaded "$SENSOR_LABEL" \
    || [ -f "$HELPER_PLIST" ] || [ -f "$HELPER_BINARY" ] \
    || service_is_loaded "$HELPER_LABEL"
then
    EXISTING_SENSOR_INSTALL=1
fi

# ---------------------------------------------------------------------------
# Step 1: Stop the sensor while the old helper is still available
# ---------------------------------------------------------------------------
# The sensor's graceful shutdown removes proxy ARP entries, loopback aliases,
# and PF rules through the helper.  Component package script ordering is not a
# safe reason to assume the sensor package's preinstall already did this.
if ! stop_service_and_verify "$SENSOR_LABEL" "sensor daemon"; then
    echo "[app-preinstall] Retaining PF and the existing installation." >&2
    exit 1
fi

# Remove durable virtual addresses directly while running as root. This covers
# force-killed upgrades where the sensor could not complete helper cleanup.
is_valid_ipv4() {
    local ip="$1"
    local -a octets
    local octet
    IFS='.' read -r -a octets <<< "$ip"
    [ "${#octets[@]}" -eq 4 ] || return 1
    for octet in "${octets[@]}"; do
        [[ "$octet" =~ ^[0-9]{1,3}$ ]] || return 1
        [ "$((10#$octet))" -le 255 ] || return 1
    done
}

has_ipv4_address() {
    local interface="$1"
    local ip="$2"
    /sbin/ifconfig "$interface" 2>/dev/null \
        | /usr/bin/awk -v ip="$ip" \
            '$1 == "inet" && $2 == ip { found = 1 } END { exit !found }'
}

has_loopback_host_alias() {
    local ip="$1"
    /sbin/ifconfig lo0 2>/dev/null \
        | /usr/bin/awk -v ip="$ip" \
            '$1 == "inet" && $2 == ip && $3 == "netmask" \
             && tolower($4) == "0xffffffff" { found = 1 } \
             END { exit !found }'
}

proxy_arp_is_absent() {
    local interface="$1"
    local ip="$2"
    local output
    if output=$(/usr/sbin/arp -n -i "$interface" "$ip" 2>&1); then
        [[ "$output" != *published* && "$output" == *"($ip) at "* ]]
        return
    fi
    [[ "$output" != *published* && "$output" == *"-- no entry"* ]]
}

LOCAL_INTERFACES=()
physical_interface_for_ipv4() {
    local ip="$1"
    local candidate
    for candidate in "${LOCAL_INTERFACES[@]}"; do
        [ "$candidate" = "lo0" ] && continue
        if has_ipv4_address "$candidate" "$ip"; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

remaining_aliases=0
state_was_loaded=0
if [ "$EXISTING_SENSOR_INSTALL" -eq 1 ] && [ ! -f "$SENSOR_DB" ]; then
    echo "[app-preinstall] Cannot verify virtual-IP state for an existing installation; retaining PF and aborting." >&2
    exit 1
fi

if [ -f "$SENSOR_DB" ]; then
    if ! local_interface_list=$(/sbin/ifconfig -l 2>/dev/null); then
        echo "[app-preinstall] Cannot enumerate local interfaces; retaining PF and aborting." >&2
        exit 1
    fi
    read -r -a LOCAL_INTERFACES <<< "$local_interface_list"
    if [ "${#LOCAL_INTERFACES[@]}" -eq 0 ]; then
        echo "[app-preinstall] No local interfaces were reported; retaining PF and aborting." >&2
        exit 1
    fi
    loopback_was_listed=0
    for local_interface in "${LOCAL_INTERFACES[@]}"; do
        if [ "$local_interface" = "lo0" ]; then
            loopback_was_listed=1
        fi
        if ! /sbin/ifconfig "$local_interface" >/dev/null 2>&1; then
            echo "[app-preinstall] Cannot inspect interface ${local_interface}; retaining PF and aborting." >&2
            exit 1
        fi
    done
    if [ "$loopback_was_listed" -ne 1 ]; then
        echo "[app-preinstall] Cannot verify the loopback interface; retaining PF and aborting." >&2
        exit 1
    fi
    if [ ! -x /usr/bin/sqlite3 ]; then
        echo "[app-preinstall] sqlite3 is unavailable; retaining PF and aborting." >&2
        exit 1
    fi
    if ! database_check=$(
        /usr/bin/sqlite3 "$SENSOR_DB" "PRAGMA quick_check;"
    ); then
        echo "[app-preinstall] Cannot validate the sensor database; retaining PF and aborting." >&2
        exit 1
    fi
    if [ "$database_check" != "ok" ]; then
        echo "[app-preinstall] Sensor database integrity check failed; retaining PF and aborting." >&2
        exit 1
    fi
    if ! virtual_ip_rows=$(
        /usr/bin/sqlite3 -separator '|' "$SENSOR_DB" \
            "SELECT DISTINCT ip_address, interface FROM virtual_ips WHERE released_at IS NULL;"
    ); then
        echo "[app-preinstall] Cannot read recorded virtual IPs; retaining PF and aborting." >&2
        exit 1
    fi
    state_was_loaded=1
    while IFS='|' read -r virtual_ip virtual_interface; do
        # An empty result is represented by one empty here-string iteration.
        if [ -z "$virtual_ip" ] && [ -z "$virtual_interface" ]; then
            continue
        fi
        if ! is_valid_ipv4 "$virtual_ip" \
            || [[ ! "$virtual_interface" =~ ^[[:alnum:]]+$ ]]; then
            echo "[app-preinstall] Invalid virtual-IP state row; retaining PF and aborting." >&2
            remaining_aliases=1
            continue
        fi

        if physical_interface=$(
            physical_interface_for_ipv4 "$virtual_ip"
        ); then
            echo "[app-preinstall] Tracked virtual IP is assigned to physical interface ${physical_interface}: ${virtual_ip}." >&2
            echo "[app-preinstall] Manual cleanup is required before continuing; automatic physical-address removal is unsafe." >&2
            remaining_aliases=1
            continue
        fi

        has_tracked_loopback_alias=0
        if has_loopback_host_alias "$virtual_ip"; then
            has_tracked_loopback_alias=1
        elif has_ipv4_address lo0 "$virtual_ip"; then
            echo "[app-preinstall] Refusing to remove non-/32 lo0 address $virtual_ip; retaining PF." >&2
            echo "[app-preinstall] Manual cleanup is required before continuing." >&2
            remaining_aliases=1
            continue
        fi

        if [ "$has_tracked_loopback_alias" -eq 1 ]; then
            /usr/sbin/arp -d "$virtual_ip" pub ifscope "$virtual_interface" \
                >/dev/null 2>&1 || true
            if ! proxy_arp_is_absent "$virtual_interface" "$virtual_ip"; then
                echo "[app-preinstall] Proxy ARP for $virtual_ip is still published; retaining PF." >&2
                remaining_aliases=1
                continue
            fi

            if ! /sbin/ifconfig lo0 inet "$virtual_ip" -alias \
                >/dev/null 2>&1
            then
                echo "[app-preinstall] Could not remove tracked lo0 /32 alias $virtual_ip; retaining PF." >&2
                remaining_aliases=1
                continue
            fi

            if has_ipv4_address lo0 "$virtual_ip" \
                || ! proxy_arp_is_absent "$virtual_interface" "$virtual_ip"
            then
                echo "[app-preinstall] Virtual IP $virtual_ip cleanup could not be verified; retaining PF." >&2
                remaining_aliases=1
            fi
        elif ! proxy_arp_is_absent "$virtual_interface" "$virtual_ip"; then
            echo "[app-preinstall] Proxy ARP exists without a matching lo0 /32 alias for $virtual_ip." >&2
            echo "[app-preinstall] Manual cleanup is required before continuing; automatic proxy-ARP deletion is unsafe." >&2
            remaining_aliases=1
        fi
    done <<< "$virtual_ip_rows"
fi

if [ "$remaining_aliases" -ne 0 ]; then
    echo "[app-preinstall] Refusing to continue while a protected virtual IP remains." >&2
    exit 1
fi

# PF is cleared only after every recorded alias has been verified absent.
if [ "$state_was_loaded" -eq 1 ]; then
    if ! /sbin/pfctl -a com.apple/squirrelops -F all >/dev/null 2>&1; then
        echo "[app-preinstall] PF anchor cleanup failed; aborting upgrade." >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Step 2: Stop the privileged helper daemon (if running)
# ---------------------------------------------------------------------------
if ! stop_service_and_verify "$HELPER_LABEL" "privileged helper daemon"; then
    echo "[app-preinstall] Existing app and helper payloads were not replaced." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Step 3: Quit the app if it's running
# ---------------------------------------------------------------------------
if pgrep -x SquirrelOpsHome >/dev/null 2>&1; then
    echo "[app-preinstall] Stopping running SquirrelOps Home..."
    killall SquirrelOpsHome 2>/dev/null || true
    sleep 1
fi

# ---------------------------------------------------------------------------
# Step 4: Remove existing app bundle
# ---------------------------------------------------------------------------
# macOS Installer may skip overwriting an existing .app with the same bundle
# version. Force-removing it ensures the new payload is always written.
if [ -d "$APP_PATH" ]; then
    echo "[app-preinstall] Removing existing app at $APP_PATH"
    rm -rf "$APP_PATH"
fi

# ---------------------------------------------------------------------------
# Step 5: Forget stale package receipt
# ---------------------------------------------------------------------------
# If a previous install was relocated (e.g. macOS found an existing bundle
# with the same ID in a dev build directory), the receipt will point there.
# Clearing it forces the installer to use the distribution.xml install path
# (/Applications) instead of the old receipt location.
if pkgutil --pkg-info "$PKG_ID" &>/dev/null; then
    echo "[app-preinstall] Clearing stale receipt for $PKG_ID"
    pkgutil --forget "$PKG_ID" 2>/dev/null || true
fi

echo "[app-preinstall] Done."
exit 0
