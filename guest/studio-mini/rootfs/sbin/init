#!/bin/sh
set -eu

export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export HOME=/root

fail() {
    echo "studio-mini boot failed: $*" >&2
    exec /bin/sh
}

mkdir -p /dev /proc /run /sys /var/log/samba /var/lib/samba/private
mount -t devtmpfs devtmpfs /dev || fail "devtmpfs"
mount -t proc proc /proc || fail "proc"
mount -t sysfs sysfs /sys || fail "sysfs"
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run || fail "run tmpfs"
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts || fail "devpts"
ip link set lo up || fail "loopback link"
ip address replace 127.0.0.1/8 dev lo || fail "loopback address"

modprobe virtio_vsock 2>/dev/null || true
modprobe vmw_vsock_virtio_transport_common 2>/dev/null || true
modprobe vmw_vsock_virtio_transport 2>/dev/null || true

mkdir -p /run/sshd /run/squirrelops
umask 077
socat -u VSOCK-LISTEN:10000,reuseaddr CREATE:/run/squirrelops/persona.tar,mode=0600 \
    || fail "persona channel"

persona_size="$(wc -c < /run/squirrelops/persona.tar | tr -d '[:space:]')"
case "$persona_size" in
    ''|*[!0-9]*) fail "persona size" ;;
esac
if [ "$persona_size" -le 0 ] || [ "$persona_size" -gt 524288 ]; then
    fail "persona size"
fi

tar -tf /run/squirrelops/persona.tar > /run/squirrelops/persona.paths \
    || fail "persona archive"
while IFS= read -r archive_path; do
    case "$archive_path" in
        /*|../*|*/../*|*/..|.|*/.) fail "persona path" ;;
        etc/hostname|run/squirrelops/persona.json|Users/buildbot/*) ;;
        *) fail "unexpected persona path" ;;
    esac
done < /run/squirrelops/persona.paths

tar -xf /run/squirrelops/persona.tar -C / --no-same-owner --no-same-permissions \
    || fail "persona extraction"
rm -f /run/squirrelops/persona.tar /run/squirrelops/persona.paths

persona=/run/squirrelops/persona.json
[ -f "$persona" ] || fail "persona control"
[ "$(jq -r '.persona_id' "$persona")" = "studio-mini-v1" ] || fail "persona identity"
[ "$(jq -r '.username' "$persona")" = "buildbot" ] || fail "persona user"
[ "$(jq -r '.hostname' "$persona")" = "studio-mini" ] || fail "persona hostname"
password="$(jq -r '.login_password' "$persona")"
[ "${#password}" -ge 12 ] || fail "persona password"
# The project story is drawn per install by the sensor. init owns none of it;
# it reads the slug (a path), the product (a filename), the display name (a
# commit message), and the branch (a git ref), each checked against a tight
# shape before it touches the shell.
project_slug="$(jq -r '.project_slug' "$persona")"
project_product="$(jq -r '.project_product' "$persona")"
project_name="$(jq -r '.project_name' "$persona")"
release_branch="$(jq -r '.release_branch' "$persona")"
case "$project_slug" in
    ''|*[!a-z0-9-]*) fail "persona project" ;;
esac
case "$project_product" in
    ''|*[!A-Za-z0-9]*) fail "persona project" ;;
esac
case "$project_name" in
    ''|*[!A-Za-z0-9\ .-]*) fail "persona project" ;;
esac
case "$release_branch" in
    release/[0-9]*.[0-9]*) ;;
    *) fail "persona project" ;;
esac
[ "${#project_slug}" -le 64 ] && [ "${#project_product}" -le 32 ] \
    && [ "${#project_name}" -le 64 ] && [ "${#release_branch}" -le 32 ] \
    || fail "persona project"
project="/Users/buildbot/Projects/$project_slug"
[ -f "$project/.env.local" ] || fail "persona project"

hostname studio-mini
chmod 0755 /Users || fail "macOS users directory"
adduser -D -u 501 -h /Users/buildbot -s /bin/zsh buildbot 2>/dev/null || true
printf 'buildbot:%s\n' "$password" | chpasswd || fail "login password"
chown -R buildbot:buildbot /Users/buildbot
find /Users/buildbot -type d -exec chmod 0750 {} +
find /Users/buildbot -type f -exec chmod 0640 {} +
chmod 0600 \
    /Users/buildbot/.zsh_history \
    "$project/.env.local" \
    /Users/buildbot/.cursor/mcp.json \
    /Users/buildbot/.claude/settings.json \
    /Users/buildbot/.codex/config.toml

mv "$project/.git/config" /run/squirrelops/project.gitconfig
rm -rf "$project/.git"
git -C "$project" init -b "$release_branch" >/dev/null 2>&1 || fail "git repository"
cp /run/squirrelops/project.gitconfig "$project/.git/config"
rm -f /run/squirrelops/project.gitconfig
git --git-dir="$project/.git" --work-tree="$project" config user.name "Morgan Lee"
git --git-dir="$project/.git" --work-tree="$project" config user.email "morgan.lee@hawthorn.internal"
git --git-dir="$project/.git" --work-tree="$project" add \
    README.md .gitignore "$project_product.xcodeproj" Sources fastlane
GIT_AUTHOR_DATE='2026-08-29T14:17:00Z' \
GIT_COMMITTER_DATE='2026-08-29T14:17:00Z' \
    git --git-dir="$project/.git" --work-tree="$project" \
        commit -m "Prepare $project_name ${release_branch#release/} staging build" >/dev/null 2>&1 \
    || fail "git commit"
chown -R buildbot:buildbot "$project"

ssh-keygen -A >/dev/null 2>&1 || fail "ssh host keys"
printf '%s\n%s\n' "$password" "$password" | smbpasswd -s -a buildbot >/dev/null \
    || fail "samba password"
unset password
rm -f "$persona"

# Auth lines live in the syslog memory ring and leave the guest only over the
# dedicated vsock channel below. sshd must not run with -e, which would send
# them to the console instead of syslog.
syslogd -C256
/usr/sbin/sshd -D &
sshd_pid=$!
/usr/sbin/smbd --foreground --no-process-group &
smbd_pid=$!

# Each relay reads one preamble line from the host, the TCP source port to
# bind toward the daemon, so sshd/smbd auth logs identify the LAN peer.
# backlog matches the host's 16-relay ceiling: admitted relays connect
# concurrently, and vsock resets any connect that finds the accept queue
# full (socat's default is 5), which the host reports as ECONNRESET.
socat VSOCK-LISTEN:10022,reuseaddr,fork,max-children=16,backlog=16 EXEC:"/usr/local/bin/relay-shim 22" &
ssh_relay_pid=$!
socat VSOCK-LISTEN:10445,reuseaddr,fork,max-children=16,backlog=16 EXEC:"/usr/local/bin/relay-shim 445" &
smb_relay_pid=$!

# Bidirectional on purpose: socat must read the vsock side to notice the host
# leaving, or a stale logread would hold the slot. -f is new-lines-only so a
# reconnect never replays earlier logins.
socat VSOCK-LISTEN:10514,reuseaddr,fork,max-children=2 EXEC:"logread -f" &
auth_channel_pid=$!

while kill -0 "$sshd_pid" "$smbd_pid" "$ssh_relay_pid" "$smb_relay_pid" "$auth_channel_pid" 2>/dev/null; do
    sleep 2
done
fail "service exited"
